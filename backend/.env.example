# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_NAME=scare-backend

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=elderly_care
DB_CHARSET=utf8mb4
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24
JWT_REFRESH_EXPIRES_IN=168

# 日志配置
LOG_LEVEL=debug
LOG_FILENAME=app.log
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30

# Casbin 配置
CASBIN_MODEL_PATH=./configs/casbin/model.conf
CASBIN_POLICY_PATH=./configs/casbin/policy.csv

# 邮件配置
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false

# 存储配置
STORAGE_DRIVER=local
STORAGE_SIGNED_URL_EXPIRE_SECONDS=3600
STORAGE_LOCAL_BASE_PATH=./storage
STORAGE_LOCAL_BASE_URL=http://localhost:8080/static
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_BUCKET=
STORAGE_OSS_ACCESS_KEY_ID=
STORAGE_OSS_ACCESS_KEY_SECRET=
STORAGE_OSS_REGION=
STORAGE_OSS_BASE_URL=

# 安全配置
# 身份证号 AES-256 加密密钥（32 字节 base64 编码）
# 生成方式: openssl rand -base64 32
SECURITY_ID_CARD_ENCRYPT_KEY=
