# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_NAME=scare-backend

# 数据库配置（与 backend/docker-compose.yml 默认值保持一致）
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=scare_root_pass
DB_USER=scare_user
DB_PASSWORD=scare_pass
DB_NAME=scare_db
DB_CHARSET=utf8mb4
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Redis 配置（与 backend/docker-compose.yml 默认值保持一致）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=scare_redis_pass
REDIS_DB=0
REDIS_POOL_SIZE=100

# JWT 配置（本地开发可直接使用示例值，生产环境必须替换）
JWT_SECRET=local_dev_jwt_secret_change_me
JWT_EXPIRES_IN=24
JWT_REFRESH_EXPIRES_IN=168

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT_PATH=logs/app.log
LOG_ERROR_PATH=logs/error.log
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30
LOG_COMPRESS=false
LOG_ENABLE_FILE=false
LOG_ENABLE_STDOUT=true

# 邮件配置（本地开发可留空）
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false

# 存储配置（本地开发默认使用本地文件系统）
STORAGE_DRIVER=local
STORAGE_SIGNED_URL_EXPIRE_SECONDS=3600
STORAGE_LOCAL_BASE_PATH=./storage
STORAGE_LOCAL_BASE_URL=http://localhost:8080/static
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_BUCKET=
STORAGE_OSS_ACCESS_KEY_ID=
STORAGE_OSS_ACCESS_KEY_SECRET=
STORAGE_OSS_REGION=
STORAGE_OSS_BASE_URL=

# 安全配置
# 身份证号 AES-256 加密密钥（32 字节 base64 编码）
# 本地开发可使用示例值；生产环境请替换
# 生成方式: openssl rand -base64 32
SECURITY_ID_CARD_ENCRYPT_KEY=ejvbf3qAjE9EKBBIbWoGNZCr8vHKqOd7/VtYKnGrblU=

# 高德地图配置
# 地址解析、地图选点、围栏编辑等能力需要；如本地不调试地图能力可留空
AMAP_KEY=
