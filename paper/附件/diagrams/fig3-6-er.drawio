        <mxCell id="r1" value="1:N 提交" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;endArrow=ERmany;startArrow=ERone;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="2" target="sr" parent="1">
