<mxfile host="app.diagrams.net" modified="2026-02-26" agent="Claude" version="21.0.0" type="device">
  <diagram id="fig3-4" name="图3-4 地理围栏匹配流程图">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- 开始 -->
        <mxCell id="2" value="用户提交需求坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="220" height="45" as="geometry"/>
        </mxCell>
        <!-- 获取活跃围栏 -->
        <mxCell id="3" value="获取所有活跃围栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="2" target="3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 按优先级排序 -->
        <mxCell id="5" value="按优先级降序排列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="3" target="5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 遍历围栏 -->
        <mxCell id="7" value="遍历围栏" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.loop;whiteSpace=wrap;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="5" target="7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- BoundingBox判断 -->
        <mxCell id="9" value="BoundingBox&#xa;快速检查" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="7" target="9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 不在矩形内：循环回 -->
        <mxCell id="11" value="不在矩形内" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;" edge="1" source="9" target="7" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="465"/>
              <mxPoint x="220" y="335"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 射线法精确匹配 -->
        <mxCell id="12" value="射线法&#xa;精确匹配" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="在矩形内" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="9" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- 射线法不匹配：循环回 -->
        <mxCell id="14" value="不匹配" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;" edge="1" source="12" target="7" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="605"/>
              <mxPoint x="560" y="335"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 匹配成功：返回站点ID -->
        <mxCell id="15" value="匹配成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="650" as="sourcePoint"/>
            <mxPoint x="410" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="返回站点ID&#xa;（匹配成功）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="220" height="50" as="geometry"/>
        </mxCell>
        <!-- 遍历结束无匹配 -->
        <mxCell id="17" value="遍历结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="7" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="370" as="sourcePoint"/>
            <mxPoint x="410" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- 兜底站点判断 -->
        <mxCell id="18" value="有兜底站点?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="800" width="160" height="80" as="geometry"/>
        </mxCell>
        <!-- 返回兜底站点 -->
        <mxCell id="19" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="18" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="840" as="sourcePoint"/>
            <mxPoint x="580" y="840" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="20" value="返回兜底站点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="815" width="120" height="50" as="geometry"/>
        </mxCell>
        <!-- 返回无匹配 -->
        <mxCell id="21" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="18" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="840" as="sourcePoint"/>
            <mxPoint x="240" y="840" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="22" value="返回无匹配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="815" width="120" height="50" as="geometry"/>
        </mxCell>
        <!-- 标注 -->
        <mxCell id="23" value="射线法原理：&#xa;从点向右发射射线，&#xa;统计与多边形边的交点数，&#xa;奇数表示在内部，偶数表示在外部" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#333333;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="560" width="190" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
