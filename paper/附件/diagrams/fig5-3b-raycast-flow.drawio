<mxfile host="app.diagrams.net" modified="2026-02-26" agent="Claude" version="21.0.0" type="device">
  <diagram id="fig5-3b" name="图5-3b 射线法算法流程图">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- 输入 -->
        <mxCell id="A" value="输入：点 P (x, y) 和&#xa;多边形顶点数组 vertices[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="260" height="55" as="geometry"/>
        </mxCell>
        <!-- 判断顶点数 -->
        <mxCell id="B" value="顶点数 &gt;= 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="275" y="130" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="eAB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="A" target="B" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 返回false -->
        <mxCell id="C" value="返回 false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eBC" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="B" target="C" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 初始化 -->
        <mxCell id="D" value="初始化&#xa;inside = false&#xa;j = n - 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="275" y="260" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="eBD" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="B" target="D" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- i = 0 -->
        <mxCell id="E" value="i = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="365" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="eDE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="D" target="E" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 循环判断 i < n -->
        <mxCell id="F" value="i &lt; n ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="275" y="440" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="eEF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="E" target="F" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 返回inside -->
        <mxCell id="G" value="返回 inside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="455" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eFG" value="否（遍历结束）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="F" target="G" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 条件1：边两端Y在P两侧 -->
        <mxCell id="H" value="边的两端点分别在&#xa;P 的上方和下方？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="560" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="eFH" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="F" target="H" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 条件2：P在交点左侧 -->
        <mxCell id="J" value="P 在射线与边&#xa;交点的左侧？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="700" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="eHJ" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="H" target="J" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- inside = !inside -->
        <mxCell id="K" value="inside = !inside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="720" width="150" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eJK" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="J" target="K" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- j=i, i++ -->
        <mxCell id="I" value="j = i&#xa;i = i + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="555" y="540" width="120" height="45" as="geometry"/>
        </mxCell>
        <!-- 条件1不满足 → j=i,i++ -->
        <mxCell id="eHI" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" source="H" target="I" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 条件2不满足 → j=i,i++ -->
        <mxCell id="eJI" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="J" target="I" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="740"/>
              <mxPoint x="100" y="563"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- K → I -->
        <mxCell id="eKI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="K" target="I" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- I → F 循环回 -->
        <mxCell id="eIF" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="I" target="F" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="563"/>
              <mxPoint x="710" y="475"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
