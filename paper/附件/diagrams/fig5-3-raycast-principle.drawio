<mxfile host="app.diagrams.net" modified="2026-02-26" agent="Claude" version="21.0.0" type="device">
  <diagram id="fig5-3" name="图5-3 射线法原理示意图">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- 图例 -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lt" value="图例" style="text;html=1;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="40" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="" style="ellipse;fillColor=#ef5350;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="45" y="50" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="l1t" value="待判断点 P" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="62" y="47" width="80" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="" style="shape=mxgraph.basic.x;fillColor=#ff9800;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="45" y="70" width="12" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="l2t" value="射线与边的交点" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="62" y="67" width="120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="l3t" value="→  从 P 向右发射的水平射线" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="145" y="47" width="180" height="18" as="geometry"/>
        </mxCell>

        <!-- ======= 示例1：点在内部（3个交点=奇数）======= -->
        <mxCell id="bg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="400" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="示例1：点在多边形内部" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="250" height="25" as="geometry"/>
        </mxCell>
        <!-- 多边形1（不规则五边形） -->
        <mxCell id="poly1" value="" style="shape=polygon;perimeter=polygonPerimeter;fillColor=#c8e6c9;strokeColor=#43a047;strokeWidth=2;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="260" height="180" as="geometry"/>
        </mxCell>
        <!-- 点P1（内部） -->
        <mxCell id="p1" value="P" style="ellipse;fillColor=#ef5350;strokeColor=#c62828;fontStyle=1;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="260" width="28" height="28" as="geometry"/>
        </mxCell>
        <!-- 射线1 -->
        <mxCell id="ray1" value="" style="endArrow=open;endFill=0;strokeColor=#ef5350;strokeWidth=2;dashed=1;dashPattern=5 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="178" y="274" as="sourcePoint"/><mxPoint x="420" y="274" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- 交点标记 -->
        <mxCell id="x1" value="×" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="225" y="262" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="×" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="290" y="262" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="x3" value="×" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="345" y="262" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r1t" value="交点数 = 3（奇数）→ 在内部 ✓" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="90" y="370" width="260" height="22" as="geometry"/>
        </mxCell>

        <!-- ======= 示例2：点在外部（2个交点=偶数）======= -->
        <mxCell id="bg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="400" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="示例2：点在多边形外部" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="250" height="25" as="geometry"/>
        </mxCell>
        <!-- 多边形2 -->
        <mxCell id="poly2" value="" style="shape=polygon;perimeter=polygonPerimeter;fillColor=#ffcdd2;strokeColor=#e53935;strokeWidth=2;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="220" height="180" as="geometry"/>
        </mxCell>
        <!-- 点P2（外部） -->
        <mxCell id="p2" value="P" style="ellipse;fillColor=#42a5f5;strokeColor=#1565c0;fontStyle=1;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="260" width="28" height="28" as="geometry"/>
        </mxCell>
        <!-- 射线2 -->
        <mxCell id="ray2" value="" style="endArrow=open;endFill=0;strokeColor=#42a5f5;strokeWidth=2;dashed=1;dashPattern=5 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="533" y="274" as="sourcePoint"/><mxPoint x="860" y="274" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- 交点标记 -->
        <mxCell id="x4" value="×" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="600" y="262" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="x5" value="×" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="790" y="262" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r2t" value="交点数 = 2（偶数）→ 在外部 ✗" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="530" y="370" width="260" height="22" as="geometry"/>
        </mxCell>

        <!-- 底部总结 -->
        <mxCell id="summary" value="射线法原理：从待判断点向右发射水平射线，统计与多边形各条边的交点数。&#xa;交点数为奇数则点在多边形内部，交点数为偶数则点在多边形外部。" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=12;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="430" width="620" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
